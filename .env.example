# ─────────────────────────────────────────────
#  GTM Signature App — Configuração
# ─────────────────────────────────────────────
#  Copie este arquivo para .env e preencha os valores

# URL pública da sua VPS (sem barra final)
# Exemplo: https://assinaturas.gtmalimentos.com.br
VPS_BASE_URL=https://seu-dominio.com.br

# Chave secreta do Flask (gere uma aleatória)
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria

# ─── Azure AD / Microsoft 365 ───────────────
# Acesse: https://portal.azure.com > Azure Active Directory > App registrations
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=seu-client-secret-aqui

# Domínio principal do Microsoft 365 (ex: gtmalimentos.com.br)
M365_DOMAIN=suaempresa.com.br

# ─── Exchange Online (deploy de assinaturas) ─
# App ID registrado no Azure com permissão no Exchange
EXCHANGE_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EXCHANGE_CERT_THUMBPRINT=AABBCCDDEEFF00112233445566778899AABBCCDD
EXCHANGE_ORGANIZATION=suaempresa.onmicrosoft.com

# ─── Usuário admin local ─────────────────────
ADMIN_PASSWORD=admin123
